# Copy this file to .env.local and fill in your keys.
# NEVER commit .env.local — it is already in .gitignore.

# Groq API key — used for sub-second LLM inference (Llama-3.3-70b-versatile)
# Get yours at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# (Optional) OpenAI fallback — used if GROQ_API_KEY is absent
# OPENAI_API_KEY=your_openai_api_key_here

# Supabase project URL and anon/publishable key — used for auth and private session storage
# Find these in Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Public origin used as the email confirmation redirect URL.
# Add http://localhost:3000/auth/callback and your deployed callback URL
# to Supabase Dashboard → Authentication → URL Configuration → Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
