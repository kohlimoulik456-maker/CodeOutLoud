# Copy this file to .env.local and fill in your keys.
# NEVER commit .env.local — it is already in .gitignore.

# Server-side Groq API key — required for verbal-pitch validation,
# the prep coach, and AI interview feedback. Never prefix with NEXT_PUBLIC_.
# Get yours at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Server-side URL of a whitelisted or self-hosted Piston /api/v2/execute endpoint.
# The public Piston endpoint is no longer open to unapproved callers.
# For local development with `docker compose -f piston/compose.local.yaml up -d`:
PISTON_API_URL=http://127.0.0.1:2000/api/v2/execute
PISTON_API_USERNAME=
PISTON_API_PASSWORD=

# Supabase project URL and anon/publishable key — used for auth and private session storage
# Find these in Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Public origin used as the email confirmation redirect URL.
# Add http://localhost:3000/auth/callback and your deployed callback URL
# to Supabase Dashboard → Authentication → URL Configuration → Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
